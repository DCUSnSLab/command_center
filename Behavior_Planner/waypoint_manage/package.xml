<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>waypoint_manage</name>
  <version>0.0.1</version>
  <description>Waypoint layer: semantic target (node IDs) -> guarded odom-frame waypoints for the controller. Separates frame plumbing / localization-correction propagation / waypoint recalculation from the behavior planner (future BT).</description>
  <maintainer email="min81800@cu.ac.kr">d2-521-30</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>command_center_interfaces</depend>
  <depend>map_interfaces</depend>
  <depend>tf2_ros_py</depend>
  <depend>tf2_geometry_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
