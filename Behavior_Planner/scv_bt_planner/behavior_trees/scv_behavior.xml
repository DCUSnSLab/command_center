<?xml version="1.0" encoding="UTF-8"?>
<!--
  SCV 행동 트리 (2026-09-28 설계 초안).

  모든 노드는 즉시 SUCCESS/FAILURE 를 돌려주는 '결정 트리' 방식이다 — 20 Hz 마다
  루트부터 다시 평가하고, 상태(에스컬레이션 타이머·pause 발동 여부·발행 이력)는
  Context 에 둔다. RUNNING 을 쓰지 않으므로 Sequence/Fallback 이 매 틱 처음부터 돈다.

  동작 동등성 원칙: Zone 이 없는 지도에서는 simple_behavior_planner 와 같은 결정을
  내야 한다. 구역·회전 행동은 지도에 Zone 이 있거나 경로에 실제 회전이 있을 때만 켜진다.
-->
<root BTCPP_format="4" main_tree_to_execute="ScvBehavior">
  <BehaviorTree ID="ScvBehavior">
    <Sequence name="Root">

      <!-- 안전 가드: 비상정지면 Stop(항상 FAILURE) 으로 이번 틱을 끝낸다 -->
      <Fallback name="SafetyGuards">
        <Inverter><IsEmergencyStop/></Inverter>
        <Stop reason="emergency_stop"/>
      </Fallback>

      <!-- 경로·위치 수신, 합류 정렬 완료 -->
      <MissionReady/>

      <!-- node_type 9 + stop_flag: 안전 pause (원본 safety_monitor 와 동일, 항상 SUCCESS) -->
      <SafetyPause/>

      <!-- 위험 지대 경유점: 목표·다음 경유점이 코스트맵 치명 영역(구덩이·장애물) 안이면 경로 옆 빈 곳으로
           비켜 놓고, 빈 곳이 없으면 현재 목표를 건너뛴다(최종 노드 제외). 항상 SUCCESS (2026-10-02) -->
      <AvoidHazardWaypoints clear_radius="0.75" max_shift="2.0" lookahead="3" min_dist="1.5" max_dist="6.5" allow_skip="true"/>

      <!-- 구역 진입 규칙: 행동 선택과 무관하게 항상 평가 (회전 중이어도 횡단보도 진입 전 정지) -->
      <ForceSuccess>
        <Sequence name="ZoneEntryRules">
          <ZoneIs zone="crosswalk"/>
          <PauseBeforeEntry sec="2.0"/>
        </Sequence>
      </ForceSuccess>

      <!-- 정체 에스컬레이션: 자식이 고른 행동 위에 WAIT/CREEP/ASSIST 를 얹는다 -->
      <BlockedEscalation>
        <Fallback name="SelectBehavior">
          <Sequence><NeedsReverse/>                          <Drive profile="reverse"/></Sequence>
          <Sequence><IsTurn dir="left"  min_deg="35" window_m="6"/> <Drive profile="turn_left"/></Sequence>
          <Sequence><IsTurn dir="right" min_deg="35" window_m="6"/> <Drive profile="turn_right"/></Sequence>
          <Sequence><ZoneIs zone="crosswalk"/>   <Drive profile="crosswalk"/></Sequence>
          <Sequence><ZoneIs zone="shared_road"/> <Drive profile="shared_road"/></Sequence>
          <Sequence><ZoneIs zone="gps_denied"/>  <Drive profile="gps_denied"/></Sequence>
          <Sequence><ZoneIs zone="road"/>        <Drive profile="road"/></Sequence>
          <Drive profile="sidewalk"/>
        </Fallback>
      </BlockedEscalation>

      <!-- 앵커(map→odom) 이동 시 웨이포인트 재발행 요청 -->
      <RefreshWaypoints move_m="0.5" yaw_deg="5.0"/>

    </Sequence>
  </BehaviorTree>
</root>
